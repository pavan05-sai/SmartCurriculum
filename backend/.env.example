# SmartCurriculum Backend Environment Variables Template
# Copy this file to .env and fill in your values

# Flask Environment (development / production)
FLASK_ENV=production
DEBUG=False

# Server Port (Render sets this dynamically, defaults to 5000 locally)
PORT=5000

# Secret Keys (Generate secure random strings for production)
SECRET_KEY=generate-a-strong-secret-key-for-flask-sessions
JWT_SECRET_KEY=generate-a-strong-secret-key-at-least-32-chars-long

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/smartcurriculum?retryWrites=true&w=majority
MONGODB_DB_NAME=smartcurriculum

# Anthropic Claude API Configuration (For LLM AI features)
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...
CLAUDE_MODEL=claude-3-5-sonnet-20240620

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
# Example: https://smartcurriculum.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app
