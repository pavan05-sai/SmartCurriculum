# SmartCurriculum Frontend Environment Variables Template
# Copy this file to .env or .env.local

# Backend API base URL
# In development (with Vite proxy): leave empty or use /api
# In production on Vercel/Netlify pointing to Render:
# VITE_API_URL=https://smartcurriculum-backend.onrender.com/api
VITE_API_URL=/api
